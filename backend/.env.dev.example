# Local dev template: copy to backend/.env (gitignored).
# Services come from docker-compose.dev.yml via localhost.
# KEEP THIS FILE ASCII-ONLY: slowapi reads .env with the Windows locale codec (GBK).
ENVIRONMENT=development
DATABASE_URL=postgresql://ontoprompt:ontoprompt@localhost:5432/ontoprompt
# Without Docker, use SQLite instead:
# DATABASE_URL=sqlite:///./ontoprompt.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=dev-secret-key-change-me-32chars
ENCRYPTION_KEY=
FIRST_ADMIN_USER=admin
FIRST_ADMIN_PASSWORD=admin123
UPLOADS_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontoprompt123

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

CHROMA_HOST=localhost
CHROMA_PORT=8001
