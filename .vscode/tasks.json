{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: setup",
      "detail": "Check prerequisites, create .env/venv, install deps, start containers (idempotent)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-setup.ps1",
      "problemMatcher": []
    },
    {
      "label": "infra: up",
      "type": "shell",
      "command": "docker compose -f docker-compose.dev.yml up -d --wait",
      "problemMatcher": []
    },
    {
      "label": "infra: down",
      "type": "shell",
      "command": "docker compose -f docker-compose.dev.yml down",
      "problemMatcher": []
    },
    {
      "label": "infra: logs",
      "type": "shell",
      "command": "docker compose -f docker-compose.dev.yml logs -f --tail=100",
      "problemMatcher": []
    }
  ]
}
